# SIDEQUEST — environment variables
# Copy to .env and fill in. Never commit .env (see .gitignore).
# Local dev defaults point at the containers in infra/docker-compose.yml
# so the whole stack runs at $0 without any of these being "real" yet.
# See docs/ARCHITECTURE.md and docs/DEPLOYMENT.md for what each service is for.

# --- App ---
APP_ENV=development                 # development | staging | production
API_PORT=8000
WEB_PORT=3000

# --- Database (PostgreSQL + PostGIS + pgvector) ---
DATABASE_URL=postgresql+asyncpg://sidequest:sidequest@localhost:5432/sidequest

# --- Cache / pub-sub (Valkey, Redis-API-compatible) ---
VALKEY_URL=redis://localhost:6379/0

# --- Object storage (behind StorageProvider — see services/api/app/storage.py).
# "local" (a Fly volume in prod, a plain dir in dev) is both the dev
# default and the production-safe default until a real bucket exists.
# Set STORAGE_PROVIDER=s3 for real Cloudflare R2 (or MinIO/S3) —
# S3-API-compatible, zero egress fees on R2 specifically. ---
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=sidequest-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/sidequest-dev

# --- Auth (Supabase Auth — issues the JWT the API verifies) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- AI (behind AIService abstraction — see services/api/app/ai/) ---
# ollama: local, free, no key — the dev default (docs/AI.md). Production
# target is Claude: set AI_PROVIDER=anthropic + ANTHROPIC_API_KEY, nothing
# else changes.
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# --- Embeddings (Voyage AI — content-based recommendations once pgvector
# is available; see docs/DATABASE.md) ---
VOYAGE_API_KEY=

# --- Maps (MapLibre renderer; provider = tiles/geocoding underneath) ---
KAKAO_MAPS_REST_API_KEY=            # Korea: tiles + geocoding
MAPTILER_API_KEY=                    # International fallback tiles

# --- Payments (behind PaymentProvider abstraction — see
# services/api/app/payments/). "fake" (no real money, always succeeds) is
# the dev/test default. Set PAYMENT_PROVIDER=stripe or toss + the matching
# secret key to use a real provider — see app/payments/providers/stripe.py
# and toss.py for what each actually supports today (Stripe: real
# test-mode charges work backend-only; Toss: implemented but needs a
# client-side checkout widget this repo doesn't have yet). ---
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=                    # International — a sk_test_... key is enough
TOSS_SECRET_KEY=                       # Korea

# --- Bookings (behind BookingProvider abstraction — see
# services/api/app/bookings/). "fake" is both the dev default and, today,
# the only implementation — no real vendor was ever named, see
# docs/ROADMAP.md Phase 7. ---
BOOKING_PROVIDER=fake

# --- Vision verification (behind VisionVerifier abstraction — see
# services/api/app/vision/). "ollama" (llava:7b, local, free) is the dev
# default. "fake" is the production-safe default for a hosted deployment
# where Ollama isn't reachable (see docs/DEPLOYMENT.md) — it always
# returns a clearly-labeled "not actually reviewed" result rather than a
# fabricated one; verification is advisory-only either way, see
# docs/AI.md §Vision verification. ---
VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=llava:7b

# --- CORS — comma-free JSON array of allowed origins. Must include
# whatever origin apps/web is actually served from (localhost:3000 in
# dev; your real Vercel domain in production). ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Email (behind EmailProvider abstraction — see services/api/app/email/).
# "fake" (logs instead of sending — see app/email/providers/fake.py) is
# both the dev default and the production-safe default until a real
# provider is configured. Password reset and email verification WORK
# end-to-end either way (the token/link is logged), they just don't
# reach a real inbox until you set EMAIL_PROVIDER=resend + a real key —
# see docs/DEPLOYMENT.md. ---
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=SIDEQUEST <onboarding@resend.dev>
WEB_BASE_URL=http://localhost:3000    # used to build links inside verification/reset emails

# --- Observability ---
SENTRY_DSN=                          # unset = Sentry SDK never initializes, a true no-op (both apps)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Security ---
JWT_SIGNING_SECRET=                  # only if not delegating fully to Supabase
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# =====================================================================
# apps/web — separate process, separate env (Vercel project settings in
# production, apps/web/.env.local for local dev). See docs/DEPLOYMENT.md.
# =====================================================================

# API_URL: server-side only (Server Components/Actions call the API
# directly) — no NEXT_PUBLIC_ prefix, never sent to the browser.
API_URL=http://localhost:8000/api/v1

# NEXT_PUBLIC_WS_URL: the quest-room WebSocket is opened client-side, so
# this one IS shipped to the browser bundle — use wss:// in production.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1

# NEXT_PUBLIC_API_ORIGIN: the API's bare origin (no /api/v1 — quest-photo
# URLs from POST .../verify-photo are mounted at /local-storage on the
# API app directly, see services/api/app/main.py). Client-side, used to
# render an uploaded photo's <img src>.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# =====================================================================
# Hosted deployment (Fly.io + Vercel) — see docs/DEPLOYMENT.md for the
# full step-by-step. Production-safe defaults for a fresh deploy with no
# real vendor accounts added yet:
#   AI_PROVIDER=fake, VISION_PROVIDER=fake, PAYMENT_PROVIDER=fake,
#   BOOKING_PROVIDER=fake — every one of these is honestly labeled as a
#   placeholder to real users (see app/ai/providers/fake.py and
#   app/vision/providers/fake.py's docstrings), never a silent fake.
# Vars that MUST be set to real values before deploying (no safe default):
#   DATABASE_URL, VALKEY_URL, JWT_SIGNING_SECRET, CORS_ORIGINS,
#   STORAGE_LOCAL_DIR (Fly volume path, not the dev-local dir default)
# =====================================================================
